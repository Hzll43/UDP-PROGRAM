import pygame
import socket
import sys
import time

def baca_controller(joystick, last_axis_values, last_hat_value):
    pygame.event.pump()
    axis_values = [joystick.get_axis(n) * 255 for n in (0, 1)]
    axis_values = [0 if abs(val) < 20 else val for val in axis_values]

    axis_changed = any(abs(axis_values[n] - last_axis_values[n]) > 5 for n in (0, 1))
    button_presses = [i for i in range(joystick.get_numbuttons()) if joystick.get_button(i)]
    hat_value = joystick.get_hat(0)
    hat_changed = hat_value != last_hat_value

    return axis_values, axis_changed, button_presses, hat_value, hat_changed

def kirim_udp(sock, server_ip, server_port, message):
    print(f"Sending message: {message}")
    sock.sendto(message.encode('utf-8'), (server_ip, server_port))

def main():
    SERVER_IP = "192.168.217.235"  
    SERVER_PORT = 8080  

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    pygame.init()
    pygame.joystick.init()

    if pygame.joystick.get_count() == 0:
        print("No joystick connected.")
        sys.exit()

    joystick = pygame.joystick.Joystick(0)
    joystick.init()
    print(f"Joystick '{joystick.get_name()}' connected.")

    last_axis_values = [0.0] * joystick.get_numaxes()
    last_hat_value = (0, 0)
    last_sent_time = 0
    send_interval = 0.01  

    try:
        while True:
            current_time = time.time()

            if current_time - last_sent_time >= send_interval:
                axis_values, axis_changed, button_presses, hat_value, hat_changed = baca_controller(joystick, last_axis_values, last_hat_value)

                if axis_changed:
                    message = f"Axis 0 value: {axis_values[0]:.3f}; Axis 1 value: {axis_values[1]:.3f}"
                    kirim_udp(sock, SERVER_IP, SERVER_PORT, message)
                    last_axis_values = axis_values

                for button in button_presses:
                    message = f"Button {button} pressed."
                    kirim_udp(sock, SERVER_IP, SERVER_PORT, message)

                if hat_changed:
                    message = f"D-pad value: {hat_value}"
                    kirim_udp(sock, SERVER_IP, SERVER_PORT, message)
                    last_hat_value = hat_value

                last_sent_time = current_time

    except KeyboardInterrupt:
        print("Exiting program...")

    finally:
        sock.close()
        pygame.quit()

if __name__ == "__main__":
    main()
